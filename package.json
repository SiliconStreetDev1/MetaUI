{
  "name": "@siliconst/metaui",
  "version": "2.1.1",
  "description": "Metadata-driven UI engine for SAPUI5 and OpenUI5: renders Fiori control trees at runtime from JSON Schema, OpenAPI or OData metadata",
  "author": "SiliconStreetDev1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SiliconStreetDev1/MetaUI.git"
  },
  "homepage": "https://github.com/SiliconStreetDev1/MetaUI#readme",
  "bugs": {
    "url": "https://github.com/SiliconStreetDev1/MetaUI/issues"
  },
  "keywords": [
    "ui5",
    "sapui5",
    "openui5",
    "fiori",
    "metadata",
    "engine",
    "json-schema",
    "openapi",
    "swagger",
    "odata",
    "dynamic-forms",
    "form-generator",
    "schema-driven-ui"
  ],
  "files": [
    "src",
    "ui5.yaml",
    "README.md"
  ],
  "scripts": {
    "metrics": "node scripts/run-tests.js --metrics-only",
    "lint": "node scripts/run-tests.js --lint-only",
    "typecheck": "tsc --noEmit -p .",
    "build": "ui5 build --clean-dest",
    "pretest": "npm run build",
    "test": "node scripts/run-tests.js",
    "flatten": "node scripts/flatten-bsp.js",
    "publish-prep": "node scripts/publish-prep.js",
    "pack:npm": "npm run build && npm run publish-prep",
    "pack:bsp": "npm run build && npm run flatten",
    "stress:fetch": "node scripts/fetch-stress-specs.js",
    "stress": "node -e \"process.env.TS_NODE_PROJECT='test/swagger_schemas/tsconfig.json';require('./test/swagger_schemas/node-ui5-stub.js');require('ts-node/register');require('./test/swagger_schemas/test_runner.ts')\"",
    "test:prop": "mocha --config test/node/.mocharc.json",
    "mutate": "node test/node/run-mutation.js",
    "api:snapshot": "node .github/scripts/api-surface.js dist --out .github/api-surface.txt",
    "api:check": "node .github/scripts/api-surface.js dist --check .github/api-surface.txt",
    "verify:package": "node .github/scripts/verify-package.js dist",
    "gen:accessors": "node scripts/generate-control-accessors.js",
    "gen:cheatsheet": "node scripts/generate-ai-cheatsheet.js",
    "api:tiers": "node .github/scripts/api-surface.js dist --tier-report"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "types": "dist/resources/nz/co/siliconst/ui5/metaui/library.d.ts",
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/mocha-runner": "10.0.0",
    "@types/mocha": "10.0.10",
    "@types/node": "^26.6.5",
    "@types/openui5": "^1.120.0",
    "@ui5/cli": "^3.0.0",
    "axe-core": "4.14.0",
    "fast-check": "4.10.2",
    "mocha": "12.0.3",
    "puppeteer": "^25.15.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ui5-tooling-transpile": "^3.2.0"
  },
  "ui5": {
    "dependencies": [
      "ui5-tooling-transpile"
    ]
  }
}
