<mvc:View
    controllerName="metaui.sandbox.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:f="sap.f">
    <f:DynamicPage id="page">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="MetaUI Launchpad" />
                </f:heading>
                <f:expandedContent>
                    <Label text="Select a test environment below to explore MetaUI capabilities." />
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <layout:HorizontalLayout class="sapUiContentPadding">
                <GenericTile
                    class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                    header="Schema Scenarios"
                    subheader="Kitchen Sink, Wizard, etc."
                    press=".onNavToKitchenSink">
                    <tileContent>
                        <TileContent>
                            <NumericContent value="1" icon="sap-icon://form" />
                        </TileContent>
                    </tileContent>
                </GenericTile>

                <GenericTile
                    class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                    header="OpenApi Integration"
                    subheader="OpenAPI v2 and v3 Tests"
                    press=".onNavToOpenApi">
                    <tileContent>
                        <TileContent>
                            <NumericContent value="3" icon="sap-icon://api" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
                <GenericTile
                    class="sapUiTinyMarginBegin sapUiTinyMarginTop tileLayout"
                    header="Freeform Sandbox"
                    subheader="Ad-Hoc JSON Testing"
                    press=".onNavToSandbox">
                    <tileContent>
                        <TileContent>
                            <NumericContent value="4" icon="sap-icon://syntax" />
                        </TileContent>
                    </tileContent>
                </GenericTile>
            </layout:HorizontalLayout>
        </f:content>
    </f:DynamicPage>
</mvc:View>

