<mvc:View
    controllerName="metaui.sandbox.controller.Playground"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:f="sap.f"
    xmlns:codeeditor="sap.ui.codeeditor"
    xmlns:meta="nz.co.siliconst.ui5.metaui.controls.host">
    
    <f:DynamicPage id="page" headerExpanded="true" fitContent="true" showFooter="{= ${message>/}.length > 0 }">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="MetaUI Playground" />
                </f:heading>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" press=".onNavBack" />
                </f:navigationActions>
                <f:actions>
                    <Button icon="sap-icon://action-settings" text="Settings" press=".onSettingsPress" tooltip="Configure Engine Behaviors" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        
        <f:header>
            <f:DynamicPageHeader pinnable="true">
                <Toolbar>
                    <Label text="OpenAPI Target:" visible="{= ${settings>/settings/schemaTargets} !== undefined &amp;&amp; ${settings>/settings/schemaTargets}.length > 0 }" class="sapUiTinyMarginEnd" />
                    <Select
                        id="schemaTargetSelect"
                        items="{settings>/settings/schemaTargets}"
                        selectedKey="{settings>/settings/schemaTarget}"
                        change=".onGeneratePress"
                        visible="{= ${settings>/settings/schemaTargets} !== undefined &amp;&amp; ${settings>/settings/schemaTargets}.length > 0 }"
                        class="sapUiSmallMarginEnd"
                        width="350px">
                        <core:Item key="{settings>key}" text="{settings>text}" />
                    </Select>
                    <ToolbarSpacer/>
                    <Button text="Generate Form" type="Emphasized" press=".onGeneratePress" class="sapUiSmallMarginEnd" />
                    <Button text="Extract Payload (Submit)" type="Accept" press=".onExtractPress" />
                </Toolbar>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <l:Splitter height="100%">
                
                <!-- Left Pane: Source & Schema Tabs -->
                <Page showHeader="false">
                    <layoutData>
                        <l:SplitterLayoutData size="33%" />
                    </layoutData>
                    <content>
                        <IconTabBar stretchContentHeight="true" applyContentPadding="false" expanded="true">
                        <items>
                            <IconTabFilter text="Inbound Data" key="inbound">
                                <codeeditor:CodeEditor id="inboundEditor" type="json" syntaxHints="false" height="100%" value="{/current/data}" change=".onInboundChange" />
                            </IconTabFilter>
                            <IconTabFilter text="Schema" key="schema">
                                <codeeditor:CodeEditor id="schemaEditor" type="json" syntaxHints="false" height="100%" value="{/current/schema}" change=".onSchemaChange" />
                            </IconTabFilter>
                        </items>
                    </IconTabBar>
                    </content>
                </Page>

                <!-- Center Pane: MetaUI Engine -->
                <ScrollContainer height="100%" vertical="true" width="auto">
                    <layoutData>
                        <l:SplitterLayoutData size="auto" />
                    </layoutData>
                    <VBox class="sapUiMediumMargin">
                        <Title text="Live Form Preview" level="H3" class="sapUiSmallMarginBottom" />
                        <VBox id="hostContainer" width="100%" />
                    </VBox>
                </ScrollContainer>

                
            </l:Splitter>
        </f:content>

        <f:footer>
            <OverflowToolbar>
                <Button 
                    id="messagePopoverBtn"
                    icon="sap-icon://message-popup"
                    text="{= ${message>/}.length }"
                    type="{= ${message>/}.length > 0 ? 'Negative' : 'Default' }"
                    press=".onMessagePopoverPress" />
                <ToolbarSpacer />
            </OverflowToolbar>
        </f:footer>

    </f:DynamicPage>
</mvc:View>
