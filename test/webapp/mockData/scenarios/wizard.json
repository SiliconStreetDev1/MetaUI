{
  "key": "wizard",
  "name": "Wizard Layout",
  "data": {
    "ApplicationID": "MORT-2026-X99",
    "LoanAmount": 500000,
    "LoanTermYears": 30,
    "InterestRate": 6.5,
    "PropertyAddress": "",
    "Applicant": {
      "FirstName": "",
      "LastName": "",
      "DOB": "",
      "SSN": ""
    },
    "Employment": {
      "EmployerName": "",
      "JobTitle": "",
      "YearsEmployed": 0,
      "MonthlyIncome": 0
    },
    "Assets": [],
    "Declarations": {
      "IsFirstTimeBuyer": false,
      "HasBankruptcies": false,
      "AgreesToTerms": false
    }
  },
  "schema": {
    "title": "Enterprise Mortgage Application",
    "type": "object",
    "layoutStrategy": "wizard",
    "properties": {
      "ApplicationID": {
        "type": "string",
        "ui": { "label": "Application ID", "readOnly": true }
      },
      "LoanAmount": {
        "type": "number",
        "required": true,
        "minimum": 50000,
        "ui": { "label": "Requested Loan Amount", "formatter": "currency" }
      },
      "LoanTermYears": {
        "type": "number",
        "required": true,
        "ui": { "label": "Loan Term (Years)", "widget": "select" },
        "valueHelp": [
          { "key": "15", "text": "15 Years" },
          { "key": "20", "text": "20 Years" },
          { "key": "30", "text": "30 Years" }
        ]
      },
      "InterestRate": {
        "type": "number",
        "ui": { "label": "Estimated Interest Rate (%)", "readOnly": true }
      },
      "PropertyAddress": {
        "type": "string",
        "required": true,
        "ui": { "label": "Subject Property Address", "widget": "textArea", "rows": 2 }
      },
      "Applicant": {
        "type": "object",
        "properties": {
          "FirstName": { "type": "string", "required": true, "ui": { "label": "First Name" } },
          "LastName": { "type": "string", "required": true, "ui": { "label": "Last Name" } },
          "DOB": { "type": "date", "required": true, "ui": { "label": "Date of Birth" } },
          "SSN": { "type": "string", "required": true, "ui": { "label": "Social Security Number" } }
        }
      },
      "Employment": {
        "type": "object",
        "properties": {
          "EmployerName": { "type": "string", "required": true, "ui": { "label": "Employer Name" } },
          "JobTitle": { "type": "string", "ui": { "label": "Job Title" } },
          "YearsEmployed": { "type": "number", "required": true, "ui": { "label": "Years at Company" } },
          "MonthlyIncome": { "type": "number", "required": true, "ui": { "label": "Gross Monthly Income", "formatter": "currency" } }
        }
      },
      "Assets": {
        "type": "array",
        "ui": { "label": "Liquid Assets & Accounts" },
        "items": {
          "type": "object",
          "properties": {
            "Institution": { "type": "string", "required": true, "ui": { "label": "Bank / Institution" } },
            "AccountType": { 
              "type": "string", 
              "ui": { "widget": "select" },
              "valueHelp": [
                { "key": "Checking", "text": "Checking" },
                { "key": "Savings", "text": "Savings" },
                { "key": "Investment", "text": "Investment" }
              ]
            },
            "Balance": { "type": "number", "ui": { "label": "Account Balance", "formatter": "currency" } }
          }
        }
      },
      "Declarations": {
        "type": "object",
        "properties": {
          "IsFirstTimeBuyer": { "type": "boolean", "ui": { "label": "Are you a first-time homebuyer?", "widget": "switch" } },
          "HasBankruptcies": { "type": "boolean", "ui": { "label": "Have you declared bankruptcy in the last 7 years?", "widget": "switch" } },
          "AgreesToTerms": { "type": "boolean", "required": true, "ui": { "label": "I agree to the terms and conditions" } }
        }
      }
    },
    "uiLayout": [
      {
        "type": "Group",
        "label": "Loan Details",
        "elements": [
          { "type": "Control", "scope": "#/properties/ApplicationID" },
          { "type": "Control", "scope": "#/properties/PropertyAddress" },
          { "type": "Control", "scope": "#/properties/LoanAmount" },
          { "type": "Control", "scope": "#/properties/LoanTermYears" },
          { "type": "Control", "scope": "#/properties/InterestRate" }
        ]
      },
      {
        "type": "Group",
        "label": "Applicant Information",
        "elements": [
          { "type": "Control", "scope": "#/properties/Applicant" }
        ]
      },
      {
        "type": "Group",
        "label": "Income & Employment",
        "elements": [
          { "type": "Control", "scope": "#/properties/Employment" }
        ]
      },
      {
        "type": "Group",
        "label": "Assets",
        "elements": [
          { "type": "Control", "scope": "#/properties/Assets" }
        ]
      },
      {
        "type": "Group",
        "label": "Declarations & Signatures",
        "elements": [
          { "type": "Control", "scope": "#/properties/Declarations" }
        ]
      }
    ]
  }
}