              "managerName": "Michael Scott",
              "capacityMetrics": {
                "maxTonnage": 50000,
                "currentUtilization": 84.2,
                "overflowAvailable": true,
                "safetyAudit": {
                  "passed": true,
                  "inspectorId": "INS-772",
                  "auditDate": "2026-07-28",
                  "score": 9,
                  "notes": "Excellent safety protocols observed. Minor issue with fire extinguisher tag in sector 4."
                }
              },
              "fleet": [
                {
                  "vehicleId": "TRK-001",
