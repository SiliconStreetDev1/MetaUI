                  "active": true,
                  "lastServiceDate": "2026-01-15",
                  "mileage": 124500
                },
                {
                  "vehicleId": "TRK-002",
                  "type": "Light Delivery",
                  "active": false,
                  "lastServiceDate": "2025-11-20",
                  "mileage": 85000
                }
              ],
              "inventoryCategories": ["Electronics", "Automotive", "Medical Supplies"]
            }
          }
        }
      },
      "manufacturing": {
        "vp": "Elon Musk",
        "plants": [
          {
            "plantId": "PLT-01",
