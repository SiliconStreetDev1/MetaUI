{
    "swagger": "2.0",
    "info": { "title": "Complex OA2 Test", "version": "1.0.0" },
    "definitions": {
        "User": {
            "type": "object",
            "required": ["id", "username"],
            "properties": {
                "id": { "type": "integer", "format": "int64", "readOnly": true },
                "username": { "type": "string", "maxLength": 50, "minLength": 3, "pattern": "^[a-zA-Z0-9]+$" },
                "password": { "type": "string", "format": "password" },
                "email": { "type": "string", "format": "email" },
                "website": { "type": "string", "format": "uri" },
                "birthDate": { "type": "string", "format": "date" },
                "lastLogin": { "type": "string", "format": "date-time" },
                "avatar": { "type": "string", "format": "binary" },
                "certificate": { "type": "string", "format": "byte" },
                "score": { "type": "number", "maximum": 100, "exclusiveMaximum": true, "minimum": 0, "exclusiveMinimum": true, "multipleOf": 5 },
                "isActive": { "type": "boolean", "default": true },
                "status": { "type": "string", "enum": ["active", "suspended", "deleted"] },
                "tags": { 
                    "type": "array", 
                    "items": { "type": "string" },
                    "maxItems": 10,
                    "minItems": 1,
                    "uniqueItems": true
                },
                "metadata": {
                    "type": "object",
                    "additionalProperties": true
                },
                "settings": {
                    "type": "object",
                    "additionalProperties": { "type": "string" },
                    "maxProperties": 5,
                    "minProperties": 1
                },
                "manager": { "$ref": "#/definitions/User" },
                "dynamicVariant": { "$ref": "#/definitions/DynamicVariantValue" }
            }
        },
        "DynamicVariantValue": {
            "type": "object",
            "description": "Protobuf Variant Simulation",
            "properties": {
                "string_value": { "type": "string" },
                "bool_value": { "type": "boolean" },
                "int_value": { "type": "integer" }
            }
        },
        "CompositeUser": {
            "allOf": [
                { "$ref": "#/definitions/User" },
                {
                    "type": "object",
                    "properties": {
                        "extraField": { "type": "string" }
                    }
                }
            ]
        }
    }
}
