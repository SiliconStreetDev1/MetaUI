{
  "_version": "1.58.0",
  "sap.app": {
    "id": "metaui.consumer",
    "type": "application",
    "title": "MetaUI Consumer App",
    "description": "Real Fiori app consuming @siliconst/metaui from npm",
    "applicationVersion": { "version": "1.0.0" }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": { "desktop": true, "tablet": true, "phone": true }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "metaui.consumer.view.Main",
      "type": "XML",
      "id": "app",
      "async": true
    },
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "nz.co.siliconst.ui5.metaui": {}
      }
    },
    "models": {},
    "contentDensities": { "compact": true, "cozy": true }
  }
}
