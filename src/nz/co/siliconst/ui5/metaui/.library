<?xml version="1.0" encoding="UTF-8" ?>
<library xmlns="http://www.sap.com/sap.ui.library.xsd">
	<name>nz.co.siliconst.ui5.metaui</name>
	<vendor>Siliconst</vendor>
	<version>${version}</version>
	<title>MetaUI Engine</title>
	<dependencies>
		<dependency>
			<libraryName>sap.ui.core</libraryName>
		</dependency>
		<dependency>
			<libraryName>sap.m</libraryName>
		</dependency>
		<dependency>
			<libraryName>sap.ui.layout</libraryName>
		</dependency>
		<!--
			Lazy dependencies. Each of the two below is imported by exactly one plugin module that
			PluginRegistry.preloadDependencies() requires on demand, never by anything in library.ts's
			eager import list. They must therefore stay <lazy>true</lazy> here AND stay out of
			Core.initLibrary's `dependencies` array in library.ts - the two lists are one contract.
			Both ship with OpenUI5 as well as SAPUI5, so this library has no SAPUI5-only dependency.
		-->
		<dependency>
			<libraryName>sap.ui.unified</libraryName>
			<lazy>true</lazy>
		</dependency>
		<dependency>
			<libraryName>sap.ui.codeeditor</libraryName>
			<lazy>true</lazy>
		</dependency>
	</dependencies>
</library>
